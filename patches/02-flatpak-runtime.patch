 const logger = getLogger('ManagedConfig/linux');
 
+// Flatpak mounts a read-only view of the host's /etc at /run/host/etc, but only when the
+// `host-etc` filesystem permission is granted. Managed deployments can opt in with
+// `flatpak override --user --filesystem=host-etc:ro <app-id>`.
+const FLATPAK_MANAGED_CONFIG_PATH = '/run/host/etc/wire/managed.json';
+
 // Linux has no standard MDM enrollment API, so managed status is driven by the presence of a
 // machine-wide managed config file placed by the organization. The file's presence means managed,
 // unless it explicitly opts out with `{"applockOverride": false}`. A missing/unreadable file means unmanaged.
 export function isDeviceManagedLinux(): boolean {
-  try {
-    const managedConfig = fs.readJSONSync(LINUX_MANAGED_CONFIG_PATH);
-    return managedConfig?.[APPLOCK_OVERRIDE_KEY] !== false;
-  } catch {
-    // Missing file is the normal unmanaged path; only log genuine parse errors.
-    if (fs.pathExistsSync(LINUX_MANAGED_CONFIG_PATH)) {
-      logger.warn(`Failed to parse ${LINUX_MANAGED_CONFIG_PATH}, treating the device as unmanaged.`);
+  const managedConfigPaths = process.env.FLATPAK_ID
+    ? [FLATPAK_MANAGED_CONFIG_PATH, LINUX_MANAGED_CONFIG_PATH]
+    : [LINUX_MANAGED_CONFIG_PATH];
+
+  for (const managedConfigPath of managedConfigPaths) {
+    if (!fs.pathExistsSync(managedConfigPath)) {
+      continue;
+    }
+    try {
+      const managedConfig = fs.readJSONSync(managedConfigPath);
+      return managedConfig?.[APPLOCK_OVERRIDE_KEY] !== false;
+    } catch {
+      // The file exists but is unreadable or malformed. Treat it as unmanaged and do not
+      // fall back to the sandbox's /etc, which is never the host policy file.
+      logger.warn(`Failed to parse ${managedConfigPath}, treating the device as unmanaged.`);
+      return false;
     }
-    return false;
   }
+  return false;
 }
